    positives = negatives = zeros = 0
    for i in numbers:
        if i > 0:
            positives += 1
        elif i == 0:
            zeros += 1
        elif i < 0:
            negatives += 1
    return('positive: ', positives, 'negative: ', negatives, 'zero: ', zeros)

