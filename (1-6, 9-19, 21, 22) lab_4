# Write a function:
#
#   min_max(numbers)
#
# It receives a list of numbers.
#
# Use loops and conditions to find:
#   the minimum value
#   the maximum value
#
# Return both values.
#
# Do NOT use:
#   min()
#   max()
#
# Test with:
# values = [7, 2, 9, -1, 5, 12, 3]
#
# Unpack the result into:
#   smallest
#   largest
#
# Then print them.

# Write your code below:

def min_max(numbers):
    smallest = numbers[0]
    largest = numbers[-1]
    for i in numbers:
        if i < smallest:
            smallest = i
        if i > largest:
            largest = i
    return(smallest, largest)

values=[7, 2, 9, 5, 12, 3]
print(min_max(values))



