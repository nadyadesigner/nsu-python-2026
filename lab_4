print('  ============================================================')
# Ask the user for a positive integer.
#
# Use a while loop to print from that number down to 1.
# Then print:
#   Go!
#
# Example:
# Input: 5
# Output:
# 5
# 4
# 3
# 2
# 1
# Go!
#
# Make sure the loop variable changes.

# Write your code below:
import time

countdown = int(input('enter your number: '))
while countdown != 0:
    print(countdown)
    time.sleep(1)
    countdown-=1
print('Go!')

