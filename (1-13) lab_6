print('Task 3 — Higher-order function')
# ============================================================

def square(numbers):
    return(numbers*numbers)
def transform(values, operation):
    result=[]
    for i in values:
        result.append(operation(i))
    return result

values = [1,2,3]
print(transform(values, square))

